NAME:scb
CC:gcc

dev:
 -D DEBUG_COLOR_TRUE


debug:-g

CFLAGS:
  -Wall -Werror -Wextra 
  %debug %_LOG 

#%dev

default:
  -D=HELLO

test:
  %_LINUX   -D OS=LINUX
  %_WINDOWS -D OS=WINDOWS
  %_MACOS   -D OS=MACOS
  %_DEFAULT -D OS=D

# if no default and no case is catch var woud be empty
foo:A
bar:B
  %baz
baz:C
  %foo\wd
  %test
  %_ROOT
  %_ENV_PWD %LOG

ING:
  doc!
PROG:
  %debug 
  %default 

sys:
  %_LINUX linux heh 
  %_WINDOWS B
  %_MACOS C

DEP:
  echo foo %foo!
  echo bar %bar!
  echo baz %baz!
  %blah!

CLEAN:
  echo done;

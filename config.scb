NAME:scb
CC:gcc

dev:
 -D DEBUG_COLOR_TRUE


debug:-g

CFLAGS:
  -Wall -Werror -Wextra 
  %debug %_LOG 

default:
  -D=HELLO

test:
  %_LINUX   -D OS=LINUX
  %_WINDOWS -D OS=WINDOWS
  %_MACOS   -D OS=MACOS
  %_DEFAULT -D OS=D

# if no default and no case is catch var woud be empty

ING:
  doc!

sys:
  %_MSG target ->
  %_MSG linux
  %_MSG end
  %_LINUX %_MSG linux
  %_WINDOWS %_MSG windows
  %_MACOS %_MSG macos


PROG:
  %sys
  %debug 
  %default %_LOG


DEP:
  echo foo %foo!
  echo bar %bar!
  echo baz %baz!
  %blah!

CLEAN:
  echo done;

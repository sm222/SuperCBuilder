NAME:scb

linux_comp:
  %_T_WINDOWS\ x86_64-w64-mingw32-gcc
  %_T_LINUX\ \ cc

windows_comp:
  %_T_LINUX\ \ cc
  %_T_WINDOWS\ cl


CC:
  %_P_LINUX\ \ %linux_comp
  %_P_MACOS\ \ cc
  %_P_WINDOWS\ %windows_comp
  %_LOG


dev:
 -D DEBUG_COLOR_TRUE


debug:-g

CFLAGS:
  -Wall -Werror -Wextra 
  %debug %_LOG 

default:
  -D=HELLO

test:
  %_P_LINUX   -D OS=LINUX
  %_P_WINDOWS -D OS=WINDOWS
  %_P_MACOS   -D OS=MACOS
  %_T_DEFAULT -D OS=D

# if no default and no case is catch var woud be empty

ING:
  doc!

sys:
  %_T_WINDOWS %_MSG windows
  %_T_MACOS %_MSG macos


PROG:
  %sys
  %debug 
  %default %_LOG


DEP:
  echo foo %foo!
  echo bar %bar!
  echo baz %baz!


CLEAN:
  echo done;